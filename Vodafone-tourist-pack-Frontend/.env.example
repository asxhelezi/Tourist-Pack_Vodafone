# SerpAPI key for live Google Events (https://serpapi.com/google-events-api).
# Without it, the app falls back to the local data/events.json sample set.
SERPAPI_API_KEY=

# Optional custom exchange-rate endpoint (open.er-api.com-compatible shape, base ALL).
# Without it, the free open.er-api.com endpoint is tried; on failure the
# fallback rate table in data/currenciesFallback.ts is used.
CURRENCY_API_URL=

# Optional custom map tile URL (defaults to OpenStreetMap tiles).
NEXT_PUBLIC_MAP_TILE_URL=

# Base URL of the Spring Boot backend (orders, packages, activation). Defaults
# to http://localhost:8080 for local dev when unset.
NEXT_PUBLIC_BACKEND_URL=
